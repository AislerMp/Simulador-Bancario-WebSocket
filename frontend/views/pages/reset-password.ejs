<%- include("../partials/pageStart", { title }) %>
<%- include("../partials/header", { showLogout }) %>

<main class="page-center">
  <section class="auth-card">
    <p class="brand">Nueva contraseña</p>
    <h1>Restablecer contraseña</h1>
    <p class="subtitle">
      Ingrese el código de seis dígitos enviado al correo y establezca una nueva contraseña.
    </p>

    <%- include("../partials/message", { message, messageType }) %>

    <form class="form" action="/restablecer-password" method="POST">
      <label>
        Correo electrónico
        <input
          type="email"
          name="correo"
          value="<%= values.correo || '' %>"
          autocomplete="email"
          required
        >
      </label>

      <label>
        Código de recuperación
        <input
          class="code-input"
          type="text"
          name="codigo"
          inputmode="numeric"
          minlength="6"
          maxlength="6"
          pattern="[0-9]{6}"
          required
        >
      </label>

      <label>
        Nueva contraseña
        <input
          type="password"
          name="nuevaPassword"
          minlength="8"
          autocomplete="new-password"
          required
        >
      </label>

      <label>
        Confirmar nueva contraseña
        <input
          type="password"
          name="confirmacion"
          minlength="8"
          autocomplete="new-password"
          required
        >
      </label>

      <small>
        Use al menos 8 caracteres, una mayúscula, una minúscula y un número.
      </small>

      <button type="submit">Actualizar contraseña</button>
    </form>
  </section>
</main>

<%- include("../partials/pageEnd") %>
