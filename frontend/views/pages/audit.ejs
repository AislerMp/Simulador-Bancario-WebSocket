<%- include("../partials/pageStart", { title }) %>
<%- include("../partials/header", { showLogout }) %>

<main class="dashboard">
  <section class="welcome-card">
    <h1><%= title %></h1>
    <p>Eventos registrados en la bitácora del backend.</p>
    <%- include("../partials/message", { message, messageType }) %>
  </section>

  <section class="table-card">
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Usuario</th>
            <th>Acción</th>
            <th>Descripción</th>
            <th>Fecha</th>
            <th>IP origen</th>
          </tr>
        </thead>
        <tbody>
          <% if (movements.length === 0) { %>
            <tr><td colspan="6">No hay movimientos para mostrar.</td></tr>
          <% } %>
          <% movements.forEach((item) => { %>
            <tr>
              <td><%= item.id_bitacora %></td>
              <td><%= item.nombre_usuario %></td>
              <td><%= item.accion %></td>
              <td><%= item.descripcion %></td>
              <td><%= new Date(item.fecha_hora).toLocaleString("es-CR") %></td>
              <td><%= item.ip_origen || "-" %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</main>

<%- include("../partials/pageEnd") %>
