<%- include("../partials/pageStart", { title }) %>
<%- include("../partials/header", { showLogout }) %>

<main class="page-center">
  <section class="auth-card">
    <p class="brand">Acceso seguro</p>
    <h1>Iniciar sesión</h1>
    <p class="subtitle">Ingrese sus credenciales para recibir el código MFA.</p>

    <%- include("../partials/message", { message, messageType }) %>

    <form class="form" action="/login" method="POST">
      <label>
        Correo electrónico
        <input
          type="email"
          name="correo"
          value="<%= values.correo || '' %>"
          autocomplete="email"
          required
        >
      </label>

      <label>
        Contraseña
        <input
          type="password"
          name="password"
          autocomplete="current-password"
          required
        >
      </label>

      <button type="submit">Ingresar</button>
    </form>

    <p class="footer-text">
      <a href="/recuperar-password">¿Olvidó su contraseña?</a>
    </p>
    <p class="footer-text">
      ¿No tiene una cuenta? <a href="/register">Registrarse</a>
    </p>
  </section>
</main>

<%- include("../partials/pageEnd") %>
