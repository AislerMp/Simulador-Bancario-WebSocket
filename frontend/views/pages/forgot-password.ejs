<%- include("../partials/pageStart", { title }) %>
<%- include("../partials/header", { showLogout }) %>

<main class="page-center">
  <section class="auth-card">
    <p class="brand">Recuperación segura</p>
    <h1>Recuperar contraseña</h1>
    <p class="subtitle">
      Escriba el correo registrado. Si existe, recibirá un código de recuperación.
    </p>

    <%- include("../partials/message", { message, messageType }) %>

    <form class="form" action="/recuperar-password" method="POST">
      <label>
        Correo electrónico
        <input
          type="email"
          name="correo"
          value="<%= values.correo || '' %>"
          autocomplete="email"
          required
        >
      </label>

      <button type="submit">Enviar código</button>
    </form>

    <p class="footer-text"><a href="/login">Volver al inicio de sesión</a></p>
  </section>
</main>

<%- include("../partials/pageEnd") %>
