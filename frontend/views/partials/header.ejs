<header class="topbar">
  <div class="topbar-content">
    <a class="brand-link" href="<%= showLogout ? '/dashboard' : '/login' %>">
      <span class="brand-mark" aria-hidden="true">SB</span>
      <span class="brand-copy">
        <span>Simulador</span>
        <strong>Bancario</strong>
      </span>
    </a>

    <% if (showLogout) { %>
      <form action="/logout" method="POST">
        <button class="secondary-button" type="submit">Cerrar sesión</button>
      </form>
    <% } %>
  </div>
</header>
